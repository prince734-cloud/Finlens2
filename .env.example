# =================================================================
# FinLens — Environment Variables Configuration
# =================================================================

# Server Settings
APP_NAME="FinLens — AI Financial Intelligence & Investment Research Platform"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Memory Optimization Flags (Set both to True/False for Render & Railway Free Tier)
# When LOW_MEMORY_MODE=True and USE_CROSS_ENCODER=False, RAM footprint stays < 150MB (fits 512MB limit)
LOW_MEMORY_MODE=True
USE_CROSS_ENCODER=False

# Comma-separated browser origins allowed to call the API.
# Set this to your exact Vercel or custom frontend deployment URL in Railway / Render.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Connection
# PostgreSQL: postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
# SQLite Fallback: sqlite+aiosqlite:///./finlens.db
DATABASE_URL="sqlite+aiosqlite:///./finlens.db"

# Vector Store Engine ('chroma' or 'pgvector')
VECTOR_STORE_BACKEND="chroma"
CHROMA_PERSIST_DIR="./data/chroma_db"

# LLM Provider Configuration ('groq', 'mistral', 'anthropic', 'gemini')
LLM_PROVIDER="groq"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# API Keys (Provide at least one LLM provider)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Embedding Provider Configuration
# Options:
# - 'hf_api' (Recommended for 512MB free tier: 0MB RAM, exact 384-d vectors, free)
# - 'gemini' (0MB RAM, Google text-embedding-004, 768-d, free tier 1500 RPM)
# - 'mistral' (0MB RAM, Mistral mistral-embed, 1024-d)
# - 'lightweight' (0MB RAM, deterministic offline fallback)
# - 'huggingface' (Local PyTorch transformer, requires >= 2GB RAM)
EMBEDDING_PROVIDER="hf_api"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
HF_TOKEN=""

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
TOP_K_RERANKED=3
