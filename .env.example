# =================================================================
# FinLens — Environment Variables Configuration
# =================================================================

# Server Settings
APP_NAME="FinLens — AI Financial Intelligence & Investment Research Platform"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Comma-separated browser origins allowed to call the API.
# Set this to the exact Vercel deployment URL in Railway.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Connection
# PostgreSQL: postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
# SQLite Fallback: sqlite+aiosqlite:///./finlens.db
DATABASE_URL="sqlite+aiosqlite:///./finlens.db"

# Vector Store Engine ('chroma' or 'pgvector')
VECTOR_STORE_BACKEND="chroma"
CHROMA_PERSIST_DIR="./data/chroma_db"

# LLM Provider Configuration ('groq', 'mistral', 'anthropic', 'gemini')
LLM_PROVIDER="groq"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# API Keys (Provide at least one provider)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Embedding & Reranking Models
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
TOP_K_RERANKED=3
